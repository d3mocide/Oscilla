# oscilla-c5 defaults. Radio features are enabled as their phases land.

CONFIG_IDF_TARGET="esp32c5"

# XIAO ESP32-C5 has 8 MB flash (boot log: "Detected size(8192k)").
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# The delivered XIAO ESP32-C5 variant carries 8 MB of PSRAM. Keep
# performance-sensitive stacks and radio queues internal; app-owned bulk
# state opts into PSRAM explicitly with MALLOC_CAP_SPIRAM. The Wi-Fi driver's
# own buffers are the exception below (D-23).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=y

# App and bootloader logs go to native USB, never the command channel
# (Rev D §3). ROM boot text still appears on UART0; OCP-SPEC §1.1 tolerates it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Single-core: dispatch must outrank engines so `stop` lands (DESIGN §6.4).
CONFIG_FREERTOS_HZ=1000

# Fault, never hang (Rev D §4.3). PANIC is deliberate: the default only prints
# a warning, so a starved core stays wedged and the probe cannot even be
# reflashed over USB. Rebooting is always the better failure.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# BLE passive scan (ble_recon.c, OCP-SPEC §11). NimBLE only — no classic BT,
# no GATT server: the C5 has a single 2.4 GHz radio shared with Wi-Fi via
# radio_arbiter (PHY_OWNER_BLE), same coexistence story as Wi-Fi already has.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# D-17 802.15.4 observer. zig_radio.c enables hardware promiscuous mode before
# receiving; ESP-IDF then disables automatic ACK transmission.
CONFIG_IEEE802154_ENABLED=y

# NimBLE overflows the default 1 MB factory-app partition by ~126 KB; the
# XIAO's 8 MB flash has plenty of room, so grow the app partition instead of
# trimming anything (1500 KB, Espressif's own "large" single-app table —
# same fix the bleprph_wifi_coex example ships with, not a guess).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Memory placement (WORKLOG 2026-11-24, heap pass 2).
# The system event task runs our Wi-Fi scan-done handler; 2304 bytes left
# 224 bytes of headroom on hardware. 3584 gives ~1.5 KB.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584
# NimBLE host pools (msys/mbufs) in PSRAM: +4.9 KB internal, BLE scans
# unchanged on the bench (75 devices / 86 events vs 89).
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# D-23: Wi-Fi driver buffers in PSRAM. Under heavy sniffing the driver holds up
# to 32 dynamic RX buffers (~2 KB each) in internal RAM: low-water fell to
# 8.5 KB in a 45 min sniffer+LoRa+OOK run. With this on, the same run bottoms at
# 86 KB. Bench A/B (WORKLOG 2026-11-25): sniffer capture unchanged, wardrive
# ~2% fewer unique networks. Enabling it forces static TX buffers (default 16,
# ~26 KB internal); the probe never sends data frames, so 2 is plenty.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=2
# The PSRAM option also moves these defaults (static RX 10->16, ~10 KB internal;
# BA window 6->16; TCP out-of-order 4->0). Pin them to what the A/B measured.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
