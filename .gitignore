# ─── Build output ────────────────────────────────────────────────────────────
# ESP-IDF
firmware-c5/build/
firmware-c5/build-*/
# sdkconfig is generated from sdkconfig.defaults and is machine-local; only
# the defaults file is committed.
firmware-c5/sdkconfig
firmware-c5/sdkconfig.old
firmware-c5/managed_components/
firmware-c5/dependencies.lock

# bench-zig-emitter — same ESP-IDF generated-output story as firmware-c5.
bench-zig-emitter/build/
bench-zig-emitter/sdkconfig
bench-zig-emitter/sdkconfig.old
bench-zig-emitter/managed_components/
bench-zig-emitter/dependencies.lock

# PlatformIO
.pio/
firmware-cardputer/.pio/

# IDE
scratch/

# ─── Local toolchain / editor state ──────────────────────────────────────────
# Note the trailing /* rather than /: git cannot re-include a file whose
# parent directory is excluded, so the negation below would not work.
.vscode/*
# Exception: extensions.json is shareable — it says which extensions this
# project expects, not anything about this machine.
!.vscode/extensions.json
.idea/
compile_commands.json
.cache/
*.swp
.DS_Store

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ─── FIELD DATA — never commit ───────────────────────────────────────────────
# Recorded observations are the operator's movement history. Policy and
# reasoning: SECURITY.md. Write up conclusions in docs/hardware/, never rows.
*.csv
*.kml
*.kmz
*.gpx
*.nmea
*.pcap
*.pcapng
*.hccapx
*.log
sessions/
captures/
wardrive/

# Fixtures are synthetic — hand-written protocol test data, no real observations.
!tools/fixtures/**

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Nothing in v1 needs credentials. If that changes, the secret goes in a file
# matched here — never typed into a source file.
secrets.h
credentials.h
*secrets*.h
.env
.env.*
*.pem
*.key
*.p12

# ─── Crash / debug dumps ─────────────────────────────────────────────────────
# Coredumps embed RAM, including buffered observations.
*.coredump
core.*
coredump*.bin
